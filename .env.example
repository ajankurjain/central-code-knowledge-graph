# ──────────────────────────────────────────────────────────────────────────
# central-code-knowledge-graph — local development env
# Copy to `.env` and edit. Docker Compose reads `.env` automatically.
# ──────────────────────────────────────────────────────────────────────────

# Bootstrap admin token (used to create your first real API token)
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
CKG_BOOTSTRAP_TOKEN=change-me-please-bootstrap-token

# API
CKG_API_HOST=0.0.0.0
CKG_API_PORT=8080
CKG_LOG_LEVEL=INFO
CKG_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j-password
NEO4J_DATABASE=neo4j

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ckg
POSTGRES_USER=ckg
POSTGRES_PASSWORD=change-me-postgres-password

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Embeddings (local sentence-transformers; first run downloads model)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Repo storage (where the worker clones repos for parsing)
CKG_REPO_ROOT=/var/lib/ckg/repos

# Optional: limit which languages are enabled (comma-separated). Empty = all known.
CKG_ENABLED_LANGUAGES=python,javascript,typescript
