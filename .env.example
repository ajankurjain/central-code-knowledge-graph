# ──────────────────────────────────────────────────────────────────────────
# central-code-knowledge-graph — local development env
# Copy to `.env` and edit. Docker Compose reads `.env` automatically.
# ──────────────────────────────────────────────────────────────────────────

# Bootstrap admin token (used to create your first real API token)
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
CKG_BOOTSTRAP_TOKEN=change-me-please-bootstrap-token

# API
CKG_API_HOST=0.0.0.0
CKG_API_PORT=8080
CKG_LOG_LEVEL=INFO
CKG_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Web UI (Next.js)
CKG_WEB_PORT=3000
# Public URL the browser uses to reach the API. Same host as docker-compose for
# local dev; set to an external URL if you put the API behind a reverse proxy.
CKG_WEB_API_URL=http://localhost:8080

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j-password
NEO4J_DATABASE=neo4j

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ckg
POSTGRES_USER=ckg
POSTGRES_PASSWORD=change-me-postgres-password

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Embeddings (local sentence-transformers; first run downloads model)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Repo storage (where the worker clones repos for parsing)
CKG_REPO_ROOT=/var/lib/ckg/repos

# Optional: limit which languages are enabled (comma-separated). Empty = all known.
# Supported: python, javascript, typescript, rust, go, java, ruby, c, cpp
CKG_ENABLED_LANGUAGES=python,javascript,typescript,rust,go,java,ruby,c,cpp

# LSP precision pass (Phase 3, opt-in).
# When true, after each ingest the worker spawns the configured language
# servers and upgrades CALLS edges with precise (cross-file) targets.
# Requires the LSP binary to be on the worker's PATH:
#   - python: `pyright-langserver` — `npm i -g pyright` or `pip install pyright`
# Other languages will be added in subsequent phases.
CKG_LSP_ENABLED=false
# Optional CSV to limit which adapters run (e.g. "python"). Empty = all available.
CKG_LSP_ADAPTERS=
